# qq_bridge 配置模板（复制为 .env 后按需修改）
# 对应设计文档 §3.6 限流 / §8 权限模型 / §9 风控要点

# ---------- NoneBot 运行参数 ----------
DRIVER=~fastapi
# 反向 WS 服务端监听地址：NapCat 的 WebSocket 客户端连 http://<HOST>:<PORT>/onebot/v11/ws
# §9 风控 #2 建议改用非常用端口；本机监听、不对外暴露时 8080 亦可。
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# ---------- OneBot 鉴权（§9 #3：必须用强随机 Token）----------
# 生成方式：python -c "import secrets;print(secrets.token_hex(8))"
# 必须与 napcat/config/onebot11.json 的 network.websocketClients[].token 一致
# 注意：NapCat 4.x 的配置文件名是 onebot11.json（不是 onebot.json），
# 结构为 network.websocketClients[]；旧版 network.websocketReverse 写法不会被加载。
ONEBOT_V11_ACCESS_TOKEN=请改成强随机值

# ---------- 主项目能力层（唯一依赖方向：HTTP 单向）----------
MANJU_API_BASE=http://127.0.0.1:7788/api/v1
MANJU_HTTP_TIMEOUT=30
MANJU_HTTP_TIMEOUT_IMG=120
MANJU_HTTP_TIMEOUT_VIDEO=600

# ---------- §8 权限模型 ----------
# ⚠️ 账号单一来源纪律：所有 QQ / 群号**只在本文件 .env 配置一次**。
#    程序代码 / 脚本 / compose / 测试夹具里一律不得写死真实号，换号只改这里。
#    详见 docs/账号配置_换号指南.md；由 tools/check_no_hardcoded_qq.py 拦截。
#
# 机器人登录号（唯一允许登录 NapCat 的 QQ）。
# 这是登录号的唯一真相源：docker-compose.napcat.yml 用 ${BOT_UIN:?} 读取，
# 缺此项 compose 会直接报错，不会静默拿空号登录。换机器人号只改这一行。
BOT_UIN=
# 主人 QQ（多个用英文逗号分隔），拥有全部权限。严禁用主人大号登录 NapCat。
BOT_OWNER_QQ=
# 私聊白名单 / 群白名单 / 用户黑名单（多个用英文逗号分隔）
# GROUP_WHITELIST 同时是「机器人唯一允许发消息的群」：出站闸（Bot.call_api）
# 与入站 event_preprocessor 都读它。留空 = 一个群都不许发（fail-closed），
# 不是「放行所有群」；要机器人说话就必须填具体群号。
PRIVATE_WHITELIST=
GROUP_WHITELIST=
USER_BLACKLIST=
# 允许触发视频解析的 QQ（多个用英文逗号分隔）；一般填主人号
VIDEO_PARSE_OWNERS=
# true=严格白名单（对外服务时开）；false=名单为空时放行所有人（自己小号先跑通）
STRICT_WHITELIST=false

# ---------- §3.6 限流 ----------
PRIVATE_COOLDOWN=10
GROUP_COOLDOWN=5
PROMPT_MAX_LEN=300
DAILY_QUOTA=50

# ---------- §7.1 生图通道 ----------
# online=云端并发（默认，推荐对外）；local=本地 ComfyUI（独占，需串行）
IMAGE_CHANNEL=online
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
DEFAULT_COUNT=1
DEFAULT_VIDEO_MODEL=

# ---------- §3.4 任务编排 ----------
TASK_TIMEOUT=1800
POLL_INTERVAL=3

# ---------- §9 #4 回传随机延迟（秒）----------
REPLY_DELAY_MIN=1
REPLY_DELAY_MAX=3

# ---------- §3.8 会话 TTL（秒）----------
SESSION_TTL=1800

# ---------- §3.5 内容安全 ----------
SAFETY_ENABLE=true
SAFETY_EXTRA_WORDS=

# ---------- §7.3 视频超限阈值（字节）----------
VIDEO_MAX_BYTES=104857600
